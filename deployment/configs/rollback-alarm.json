{
  "AlarmName": "northstar-churn-rollback-canary-latency",
  "AlarmDescription": "Roll back the canary if p95 ModelLatency exceeds 200 ms. ModelLatency is in microseconds, so 200 ms = 200000.",
  "Namespace": "AWS/SageMaker",
  "MetricName": "ModelLatency",
  "Dimensions": [
    { "Name": "EndpointName", "Value": "northstar-churn-prod" },
    { "Name": "VariantName", "Value": "canary" }
  ],
  "ExtendedStatistic": "p95",
  "Period": 60,
  "EvaluationPeriods": 5,
  "DatapointsToAlarm": 3,
  "Threshold": 200000,
  "ComparisonOperator": "GreaterThanThreshold",
  "TreatMissingData": "notBreaching"
}
