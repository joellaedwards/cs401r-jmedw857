{
  "start": "-PT12H",
  "periodOverride": "inherit",
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 1. Infrastructure: endpoint CPU and memory (champion). CPU is a per-core sum: 0-200% on 2 vCPUs"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 1,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "CPUUtilization (alert > 80 for 3 x 5 min)",
        "region": "us-east-1",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Average",
        "metrics": [
          [
            "/aws/sagemaker/Endpoints",
            "CPUUtilization",
            "EndpointName",
            "northstar-churn-prod",
            "VariantName",
            "champion"
          ]
        ],
        "annotations": {
          "horizontal": [
            {
              "label": "P3 alert 80",
              "value": 80
            }
          ]
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 1,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "MemoryUtilization (alert > 85%)",
        "region": "us-east-1",
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Average",
        "metrics": [
          [
            "/aws/sagemaker/Endpoints",
            "MemoryUtilization",
            "EndpointName",
            "northstar-churn-prod",
            "VariantName",
            "champion"
          ]
        ],
        "annotations": {
          "horizontal": [
            {
              "label": "P4 alert 85",
              "value": 85
            }
          ]
        }
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 7,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 2. Pipeline: Glue job tasks (--enable-metrics) and failure events (EventBridge rule northstar-p3-glue-job-failed)"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 8,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Glue completed vs failed tasks",
        "region": "us-east-1",
        "view": "timeSeries",
        "stacked": false,
        "period": 3600,
        "stat": "Sum",
        "metrics": [
          [
            "Glue",
            "glue.driver.aggregate.numCompletedTasks",
            "JobName",
            "northstar-dev-transform",
            "JobRunId",
            "ALL",
            "Type",
            "count",
            {
              "label": "northstar-dev-transform numCompletedTasks"
            }
          ],
          [
            "Glue",
            "glue.driver.aggregate.numFailedTasks",
            "JobName",
            "northstar-dev-transform",
            "JobRunId",
            "ALL",
            "Type",
            "count",
            {
              "label": "northstar-dev-transform numFailedTasks"
            }
          ],
          [
            "Glue",
            "glue.driver.aggregate.numCompletedTasks",
            "JobName",
            "northstar-dev-feature-engineer",
            "JobRunId",
            "ALL",
            "Type",
            "count",
            {
              "label": "northstar-dev-feature-engineer numCompletedTasks"
            }
          ],
          [
            "Glue",
            "glue.driver.aggregate.numFailedTasks",
            "JobName",
            "northstar-dev-feature-engineer",
            "JobRunId",
            "ALL",
            "Type",
            "count",
            {
              "label": "northstar-dev-feature-engineer numFailedTasks"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 8,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Glue failure events matched (any > 0 = P3)",
        "region": "us-east-1",
        "view": "timeSeries",
        "stacked": false,
        "period": 3600,
        "stat": "Sum",
        "metrics": [
          [
            "AWS/Events",
            "TriggeredRules",
            "RuleName",
            "northstar-p3-glue-job-failed"
          ]
        ]
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 14,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 3. Model: Evidently drift on champion capture. PSI drifts ABOVE 0.2; KS p-value drifts BELOW 0.05"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 15,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "PSI, top 3 features (drift > 0.2)",
        "region": "us-east-1",
        "view": "singleValue",
        "stacked": false,
        "period": 300,
        "stat": "Maximum",
        "metrics": [
          [
            "NorthStar/ChurnModel",
            "DriftPSI",
            "EndpointName",
            "northstar-churn-prod",
            "Feature",
            "purchase_frequency_180d"
          ],
          [
            "NorthStar/ChurnModel",
            "DriftPSI",
            "EndpointName",
            "northstar-churn-prod",
            "Feature",
            "days_since_last_purchase"
          ],
          [
            "NorthStar/ChurnModel",
            "DriftPSI",
            "EndpointName",
            "northstar-churn-prod",
            "Feature",
            "purchase_frequency_30d"
          ]
        ],
        "setPeriodToTimeRange": true
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 15,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "KS p-value (drift < 0.05)",
        "region": "us-east-1",
        "view": "singleValue",
        "stacked": false,
        "period": 300,
        "stat": "Maximum",
        "metrics": [
          [
            "NorthStar/ChurnModel",
            "DriftKSPValue",
            "EndpointName",
            "northstar-churn-prod",
            "Feature",
            "purchase_frequency_90d"
          ],
          [
            "NorthStar/ChurnModel",
            "DriftKSPValue",
            "EndpointName",
            "northstar-churn-prod",
            "Feature",
            "avg_basket_size_6m"
          ]
        ],
        "setPeriodToTimeRange": true
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 15,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "DriftDetected (1 = any violation)",
        "region": "us-east-1",
        "view": "singleValue",
        "stacked": false,
        "period": 300,
        "stat": "Maximum",
        "metrics": [
          [
            "NorthStar/ChurnModel",
            "DriftDetected",
            "EndpointName",
            "northstar-churn-prod"
          ],
          [
            "NorthStar/ChurnModel",
            "DriftViolationCount",
            "EndpointName",
            "northstar-churn-prod"
          ]
        ],
        "setPeriodToTimeRange": true
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 21,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 4. Application: ModelLatency in MICROSECONDS. SLO p95 20000 (20 ms); alerts 200000 (P2) and 500000 (P1)"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 22,
      "width": 16,
      "height": 6,
      "properties": {
        "title": "ModelLatency p50 / p95 / p99 (champion, microseconds)",
        "region": "us-east-1",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Average",
        "metrics": [
          [
            "AWS/SageMaker",
            "ModelLatency",
            "EndpointName",
            "northstar-churn-prod",
            "VariantName",
            "champion",
            {
              "stat": "p50",
              "label": "p50"
            }
          ],
          [
            "AWS/SageMaker",
            "ModelLatency",
            "EndpointName",
            "northstar-churn-prod",
            "VariantName",
            "champion",
            {
              "stat": "p95",
              "label": "p95"
            }
          ],
          [
            "AWS/SageMaker",
            "ModelLatency",
            "EndpointName",
            "northstar-churn-prod",
            "VariantName",
            "champion",
            {
              "stat": "p99",
              "label": "p99"
            }
          ]
        ],
        "annotations": {
          "horizontal": [
            {
              "label": "SLO p95 20 ms",
              "value": 20000
            },
            {
              "label": "P2 200 ms",
              "value": 200000
            },
            {
              "label": "P1 500 ms",
              "value": 500000
            }
          ]
        }
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 22,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Invocations and 5XX errors (champion)",
        "region": "us-east-1",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Sum",
        "metrics": [
          [
            "AWS/SageMaker",
            "Invocations",
            "EndpointName",
            "northstar-churn-prod",
            "VariantName",
            "champion"
          ],
          [
            "AWS/SageMaker",
            "Invocation5XXErrors",
            "EndpointName",
            "northstar-churn-prod",
            "VariantName",
            "champion"
          ]
        ]
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 28,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 5. Business: daily churn alert volume = distinct predictions with score >= 0.5 (proxy for retention workload)"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 29,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ChurnAlertVolume vs PredictionVolume (last 24 h)",
        "region": "us-east-1",
        "view": "singleValue",
        "stacked": false,
        "period": 300,
        "stat": "Maximum",
        "metrics": [
          [
            "NorthStar/ChurnModel",
            "ChurnAlertVolume",
            "EndpointName",
            "northstar-churn-prod"
          ],
          [
            "NorthStar/ChurnModel",
            "PredictionVolume",
            "EndpointName",
            "northstar-churn-prod"
          ]
        ],
        "setPeriodToTimeRange": true
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 29,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ChurnAlertVolume change vs 7-day avg % (alert < -30)",
        "region": "us-east-1",
        "view": "timeSeries",
        "stacked": false,
        "period": 86400,
        "stat": "Minimum",
        "metrics": [
          [
            "NorthStar/ChurnModel",
            "ChurnAlertVolumeChangePct",
            "EndpointName",
            "northstar-churn-prod"
          ]
        ],
        "annotations": {
          "horizontal": [
            {
              "label": "P2 alert -30%",
              "value": -30
            }
          ]
        }
      }
    }
  ]
}
